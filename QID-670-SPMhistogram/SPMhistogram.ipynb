import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import scipy.stats as stats
import yfinance as yf

def get_dax_returns():
    # Download DAX historical data
    dax = yf.download("^GDAXI", period="5y", interval="1d")
    dax['Returns'] = dax['Close'].pct_change()
    dax = dax.dropna()
    return dax['Returns']

def plot_normal_fit(returns):
    mean, std = np.mean(returns), np.std(returns)
    
    # Generate normal distribution sample
    simulated_data = np.random.normal(mean, std, len(returns))
    
    # Set up seaborn styling
    sns.set_style("white")
    
    # Plot histograms with seaborn
    plt.figure(facecolor='none')
    sns.histplot(returns, bins=50, kde=False, stat="density", color='blue', label='DAX Returns', alpha=0.6)
    sns.histplot(simulated_data, bins=50, kde=False, stat="density", color='red', label=f'Normal Fit (μ={mean:.5f}, σ={std:.5f})', alpha=0.6)
    
    # Labels and legend
    plt.xlabel("Returns")
    plt.ylabel("Density")
    #plt.title("DAX Returns and Normal Distribution Fit")
    #plt.legend()
    plt.gca().patch.set_alpha(0)  # Set transparent background
    
    plt.show()
    
    print(f"Mean: {mean:.5f}")
    print(f"Standard Deviation: {std:.5f}")

# Get returns and plot
returns = get_dax_returns()
plot_normal_fit(returns)
